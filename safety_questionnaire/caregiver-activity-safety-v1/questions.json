  "questions": [
    {
      "question_id": "SAFETY_HEARING",
      "dimension": "hearing",
      "text": "Have you noticed, or has anyone told you about, any concern with how your child responds to sounds, voices or spoken communication?"
    },
    {
      "question_id": "SAFETY_VISION",
      "dimension": "vision",
      "text": "Have you noticed, or has anyone told you about, any concern with how your child looks at, follows, finds or recognises people and objects?"
    },
    {
      "question_id": "SAFETY_FINE_MOTOR",
      "dimension": "fine_motor",
      "text": "Have you noticed, or has anyone told you about, any concern with how your child uses their hands and fingers during age-appropriate activities?"
    },
    {
      "question_id": "SAFETY_GROSS_MOTOR",
      "dimension": "gross_motor",
      "text": "Have you noticed, or has anyone told you about, any concern with your child's body control, balance or age-appropriate movement?"
    }
  ],
  "checkpoint_examples": {
