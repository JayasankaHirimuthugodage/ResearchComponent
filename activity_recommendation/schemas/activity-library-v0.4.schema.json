{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "activity-library-v0.4.schema.json",
  "title": "Unified CDC and Vroom Activity Library v0.4",
  "type": "object",
  "required": [
    "library_name",
    "library_version",
    "generated_on",
    "scope",
    "counts",
    "activities"
  ],
  "properties": {
    "library_name": {
      "type": "string",
      "minLength": 1
    },
    "library_version": {
      "const": "0.4.0"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "required": [
        "checkpoints",
        "domains",
        "safety_dimensions"
      ],
      "properties": {
        "checkpoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkpoint"
          },
          "minItems": 12,
          "maxItems": 12
        },
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/domain"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "safety_dimensions": {
          "const": [
            "hearing",
            "vision",
            "fine_motor",
            "gross_motor"
          ]
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "required": [
        "total_records"
      ],
      "properties": {
        "total_records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "checkpoint": {
      "enum": [
        "CP2M",
        "CP4M",
        "CP6M",
        "CP9M",
        "CP12M",
        "CP15M",
        "CP18M",
        "CP24M",
        "CP30M",
        "CP36M",
        "CP48M",
        "CP60M"
      ]
    },
    "domain": {
      "enum": [
        "communication",
        "cognitive",
        "social_emotional"
      ]
    },
    "safetyDemand": {
      "enum": [
        "review_if_concern",
        "not_obviously_required",
        "not_established_as_essential_in_brief_descriptor",
        "required",
        "ability_required",
        "unknown",
        "not_assessed",
        "not_documented"
      ]
    },
    "activity": {
      "type": "object",
      "required": [
        "activity_id",
        "record_version",
        "library_version",
        "title",
        "activity_summary",
        "domains",
        "checkpoint_ids",
        "source_org",
        "source_url",
        "source_page",
        "source_tip_id",
        "status",
        "individual_activity_review",
        "suitability_mapping_status",
        "safety_demands",
        "retrieval_eligible_for_internal_research_demo",
        "retrieval_eligible_for_caregiver_deployment"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^ACT-[A-Z0-9-]+$"
        },
        "record_version": {
          "type": "string",
          "minLength": 1
        },
        "library_version": {
          "const": "0.4.0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "activity_summary": {
          "type": "string",
          "minLength": 1
        },
        "primary_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checkpoint_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkpoint"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_org": {
          "enum": [
            "CDC",
            "Vroom"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_tip_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "draft_for_validation",
            "source_verified_research_candidate"
          ]
        },
        "individual_activity_review": {
          "type": "string",
          "minLength": 1
        },
        "suitability_mapping_status": {
          "type": "string",
          "minLength": 1
        },
        "safety_demands": {
          "type": "object",
          "required": [
            "hearing",
            "vision",
            "fine_motor",
            "gross_motor"
          ],
          "properties": {
            "hearing": {
              "$ref": "#/$defs/safetyDemand"
            },
            "vision": {
              "$ref": "#/$defs/safetyDemand"
            },
            "fine_motor": {
              "$ref": "#/$defs/safetyDemand"
            },
            "gross_motor": {
              "$ref": "#/$defs/safetyDemand"
            }
          },
          "additionalProperties": false
        },
        "retrieval_eligible_for_internal_research_demo": {
          "type": "boolean"
        },
        "retrieval_eligible_for_caregiver_deployment": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
